<%- include('partials/header', { title: post.title }) %>

<article class="post">
  <h1><%= post.title %></h1>
  <p class="byline">
    By <%= post.author %><br>
    <time datetime="<%= isoDate(post.createdAt) %>"><%= formatDateTime(post.createdAt) %></time>
  </p>
  <div class="post-body"><%= post.content %></div>
</article>

<p class="back"><a href="/posts">Back to all posts</a></p>

<%- include('partials/footer') %>
