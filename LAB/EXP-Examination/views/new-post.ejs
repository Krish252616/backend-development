<%- include('partials/header', { title: 'New post' }) %>

<h1>New post</h1>

<% if (Object.keys(errors).length > 0) { %>
  <div class="error-summary" role="alert">
    <p>The post was not saved. Fix the following and save again.</p>
    <ul>
      <% Object.values(errors).forEach(function (message) { %>
        <li><%= message %></li>
      <% }); %>
    </ul>
  </div>
<% } %>

<form class="post-form" method="post" action="/posts">
  <div class="field">
    <label for="title">Title</label>
    <input type="text" id="title" name="title" value="<%= values.title %>" maxlength="150" required
           <% if (errors.title) { %>aria-invalid="true"<% } %>>
  </div>

  <div class="field">
    <label for="author">Author</label>
    <input type="text" id="author" name="author" value="<%= values.author %>" maxlength="60" required autocomplete="name"
           <% if (errors.author) { %>aria-invalid="true"<% } %>>
  </div>

  <div class="field">
    <label for="content">Content</label>
    <textarea id="content" name="content" rows="12" required
              <% if (errors.content) { %>aria-invalid="true"<% } %>><%= values.content %></textarea>
  </div>

  <p class="hint">The date and time are added automatically when you save.</p>

  <div class="actions">
    <button type="submit">Save post</button>
    <a class="button ghost" href="/posts">Cancel</a>
  </div>
</form>

<%- include('partials/footer') %>
